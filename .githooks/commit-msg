#!/bin/sh
# Guardrail (D-002): reject a commit message that contains a term (or an
# inflected form) from the untracked .private/banned-terms.txt. The matcher
# lives in src/scout_planner/guardrail.py and is shared with the test suite.
# Where the list is absent (fresh clone, CI) this hook does nothing.
# Enabled by `make setup` (git config core.hooksPath .githooks).

root=$(git rev-parse --show-toplevel) || exit 0
[ -f "$root/.private/banned-terms.txt" ] || exit 0

if ! command -v uv >/dev/null 2>&1; then
    echo "commit-msg: 'uv' not found, so the guardrail check could not run." >&2
    echo "commit-msg: install uv or put it on PATH (bypass once with --no-verify)." >&2
    exit 1
fi

cd "$root" || exit 1
exec uv run --quiet python -m scout_planner.guardrail --commit-msg "$1"
